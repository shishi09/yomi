# Colle ta clé API Gemini gratuite obtenue sur https://aistudio.google.com/apikey
GEMINI_API_KEY=COLLE_TA_CLE_API_ICI

# Modèle par défaut (modifiable aussi directement dans Safari)
# Choix conseillés : gemini-3.8-flash | gemini-3.5-flash-lite | gemini-3.6-flash
GEMINI_MODEL=gemini-3.8-flash

# Port local (ne pas changer sauf si 8765 est déjà occupé)
PORT=8765
