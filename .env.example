# Optional Cloud API key (or configure directly inside Yomi.app → Settings → Engine & Models)
# Supports Google Gemini, OpenAI, Anthropic Claude, OpenRouter, Mistral, DeepSeek, Groq, xAI, or any OpenAI-compatible API:
# GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# YOMI_API_KEY=

# Optional default model override (e.g. ollama:gemma4:12b, gemini-3.8-flash, openai:gpt-4.1-mini, anthropic:claude-sonnet-4-5)
# TRANSLATOR_MODEL=ollama:gemma4:12b

# Local HTTP server port (default: 8765)
PORT=8765
