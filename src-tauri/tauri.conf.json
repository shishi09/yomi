{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yomi",
  "version": "3.0.0",
  "identifier": "com.yomi.app",
  "build": {
    "frontendDist": "../app/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "app.html",
        "title": "Yomi",
        "width": 1080,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../userscript/yomi.user.js",
      "../glossaries/examples"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
